<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nageoffer.shortlink.project.dao.mapper.ShortLinkMapper">

    <resultMap id="ShortLinkRespMap" type="com.nageoffer.shortlink.project.dto.resp.ShortLinkRespDTO">
        <result property="fullShortUrl" column="full_short_url"/>
        <result property="originUrl" column="origin_url"/>
        <result property="gid" column="gid"/>
        <result property="description" column="description"/>
        <result property="totalPv" column="total_pv"/>
        <result property="totalUv" column="total_uv"/>
        <result property="totalUip" column="total_uip"/>
        <result property="todayPv" column="today_pv"/>
        <result property="todayUv" column="today_uv"/>
        <result property="todayIpCount" column="today_ip_count"/>
        <result property="activityId" column="activity_id"/>
        <result property="activityName" column="activity_name"/>
        <result property="channel" column="channel"/>
        <result property="enableStatus" column="enable_status"/>
        <result property="validDateType" column="valid_date_type"/>
        <result property="validDate" column="valid_date"/>
    </resultMap>

    <select id="pageShortLinkWithStats" resultMap="ShortLinkRespMap">
        SELECT
            l.full_short_url,
            l.origin_url,
            l.gid,
            l.description,
            l.total_pv,
            l.total_uv,
            l.total_uip,
            l.activity_id,
            l.channel,
            l.enable_status,
            l.valid_date_type,
            l.valid_date,
            a.activity_name
        FROM t_link l
        <!-- 不按 del_flag 过滤活动：活动被逻辑删除后，渠道短链仍带 activity_id，
             这里照样把活动名带出来，列表页才标得出"这条是哪个活动的渠道" -->
        LEFT JOIN t_activity a ON a.id = l.activity_id
        WHERE l.gid = #{gid}
            AND l.del_flag = 0
            AND l.user_name = #{userName}
        <choose>
            <when test="activityId != null">
                AND l.activity_id = #{activityId}
            </when>
            <otherwise>
                <!-- 默认只给普通短链。判 activity_id 本身而不是 a.id：活动被删与否不该影响可见性 -->
                <if test="includeActivity == null or includeActivity == false">
                    AND l.activity_id IS NULL
                </if>
            </otherwise>
        </choose>
        <choose>
            <when test="orderFlag == 'totalPv'">ORDER BY l.total_pv DESC</when>
            <when test="orderFlag == 'totalUv'">ORDER BY l.total_uv DESC</when>
            <when test="orderFlag == 'totalUip'">ORDER BY l.total_uip DESC</when>
            <otherwise>ORDER BY l.create_time DESC</otherwise>
        </choose>
    </select>

</mapper>
