# 复制为 .env 后使用：
#   cp .env.example .env
#
# docker compose 会自动读取同目录下的 .env。
# .env 已被 .gitignore 忽略，真实密码不要提交到仓库。
#
# 注意：MYSQL_ROOT_PASSWORD 只在 mysql_data 数据卷首次初始化时生效。
# 数据卷已存在时改这个值不会改数据库里已有的密码，需要手动执行：
#   ALTER USER 'root'@'%' IDENTIFIED WITH caching_sha2_password BY '<新密码>';
MYSQL_ROOT_PASSWORD=change-me-local-only
